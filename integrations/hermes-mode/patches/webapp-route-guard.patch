@@ -0,0 +1,128 @@
+"""The direct file/Git/MCP routes apply the same verdicts as the agent's file tools (Odysseus reviewed patch)."""
+import subprocess
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+
+@pytest.fixture()
+def env(tmp_path, monkeypatch):
+    home = tmp_path / "hermes-home"
+    work = tmp_path / "work"
+    for d in (home / "plugins", home / "webapp", home / "hooks", work):
+        d.mkdir(parents=True)
+    (home / "config.yaml").write_text("approvals: {mode: smart}\n")
+    (home / ".env").write_text("SECRET=1\n")
+    (home / "webapp" / "credential.json").write_text('{"token":"x"}')
+    (home / "plugins" / "p.py").write_text("print(1)\n")
+    (work / "a.txt").write_text("a\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_WRITE_SAFE_ROOT", str(work))
+    monkeypatch.delenv("HERMES_WEBAPP_ALLOW_GIT_PUBLISH", raising=False)
+    from hermes_cli.web_routers import files, git, mcp
+    app = FastAPI()
+    for module in (files, git, mcp):
+        app.include_router(module.router)
+    subprocess.run(["git", "init", "-q", str(work)], check=True)
+    return TestClient(app), home, work
+
+
+@pytest.mark.parametrize("rel", ["plugins/evil.py", "plugins/p.py", "hooks/h.py", "config.yaml", "webapp/credential.json", ".env"])
+def test_write_text_refused_in_hermes_state(env, rel):
+    client, home, _ = env
+    r = client.post("/api/fs/write-text", json={"path": str(home / rel), "content": "x"})
+    assert r.status_code == 403, r.text
+    if (home / rel).exists():
+        assert (home / rel).read_text() != "x"
+
+
+def test_write_text_outside_safe_root_refused_and_inside_allowed(env, tmp_path):
+    client, _, work = env
+    outside = tmp_path / "outside.txt"
+    assert client.post("/api/fs/write-text", json={"path": str(outside), "content": "x"}).status_code == 403
+    assert not outside.exists()
+    ok = client.post("/api/fs/write-text", json={"path": str(work / "a.txt"), "content": "changed\n"})
+    assert ok.status_code == 200 and (work / "a.txt").read_text() == "changed\n"
+
+
+def test_credential_reads_refused(env):
+    client, home, _ = env
+    for rel in ("webapp/credential.json", ".env"):
+        assert client.get("/api/fs/read-text", params={"path": str(home / rel)}).status_code == 403
+    assert client.get("/api/fs/list", params={"path": str(home / "webapp")}).status_code == 403
+    assert client.get("/api/fs/read-text", params={"path": str(env[2] / "a.txt")}).status_code == 200
+
+
+def test_user_blocked_folders_apply_to_reads_writes_and_delete(env):
+    import json
+    client, home, work = env
+    (work / "secrets").mkdir()
+    (work / "secrets" / "k.txt").write_text("k")
+    (home / "vault").mkdir()
+    listing = home / "vault" / "webui-trusted-workspaces.json"
+    listing.write_text(json.dumps({"blocked": [{"path": str(work / "secrets")}]}))
+    assert client.post("/api/fs/write-text", json={"path": str(work / "secrets" / "k.txt"), "content": "x"}).status_code == 403
+    assert client.get("/api/fs/read-text", params={"path": str(work / "secrets" / "k.txt")}).status_code == 403
+    assert client.request("DELETE", "/api/files", json={"path": str(work / "secrets"), "recursive": True}).status_code == 403
+    assert client.post("/api/fs/write-text", json={"path": str(work / "a.txt"), "content": "ok"}).status_code == 200
+    listing.write_text("{not json")
+    assert client.post("/api/fs/write-text", json={"path": str(work / "a.txt"), "content": "ok"}).status_code == 403   # unreadable list fails closed
+
+
+def test_delete_refuses_protected_and_containing_paths(env):
+    client, home, work = env
+    assert client.request("DELETE", "/api/files", json={"path": str(home / "plugins" / "p.py")}).status_code == 403
+    assert client.request("DELETE", "/api/files", json={"path": str(home), "recursive": True}).status_code == 403
+    assert (home / "plugins" / "p.py").exists()
+    assert client.request("DELETE", "/api/files", json={"path": str(work / "a.txt")}).status_code == 200
+
+
+def test_mkdir_and_upload_refused_in_protected_dirs(env):
+    client, home, _ = env
+    assert client.post("/api/files/mkdir", json={"path": str(home / "plugins" / "sub")}).status_code == 403
+    assert not (home / "plugins" / "sub").exists()
+
+
+def test_git_mutations_follow_the_write_verdict(env, tmp_path):
+    client, home, work = env
+    assert client.post("/api/git/review/stage", json={"path": str(work), "file": "a.txt"}).status_code != 403
+    other = tmp_path / "other"
+    other.mkdir()
+    subprocess.run(["git", "init", "-q", str(other)], check=True)
+    assert client.post("/api/git/review/stage", json={"path": str(other), "file": "x"}).status_code == 403
+    denied = client.post("/api/git/review/commit", json={"path": str(home), "message": "m"})
+    assert denied.status_code == 403 and "Git changes are not allowed here" in denied.text
+    assert client.get("/api/git/status", params={"path": str(home / "webapp")}).status_code == 403
+
+
+def test_git_publish_needs_opt_in(env, monkeypatch):
+    client, _, work = env
+    for route in ("push", "create-pr"):
+        r = client.post(f"/api/git/review/{route}", json={"path": str(work)})
+        assert r.status_code == 403 and "HERMES_WEBAPP_ALLOW_GIT_PUBLISH" in r.text
+    assert client.post("/api/git/review/commit", json={"path": str(work), "message": "m", "push": True}).status_code == 403
+    monkeypatch.setenv("HERMES_WEBAPP_ALLOW_GIT_PUBLISH", "1")
+    r = client.post("/api/git/review/push", json={"path": str(work)})
+    assert "HERMES_WEBAPP_ALLOW_GIT_PUBLISH" not in r.text       # no remote here, so Git itself fails; the guard no longer is the reason
+
+
+@pytest.mark.parametrize("command,args", [
+    ("cmd.exe", ["/c", "calc"]), ("powershell", ["-Command", "x"]), ("C:\\Windows\\System32\\bash.exe", []),
+    ("python", ["-c", "import os"]), ("node", ["-e", "1"]), ("sh", ["-c", "x"]),
+])
+def test_mcp_arbitrary_execution_refused(env, command, args):
+    client, _, _ = env
+    r = client.post("/api/mcp/servers", json={"name": "evil", "command": command, "args": args})
+    assert r.status_code == 400, r.text
+    r = client.put("/api/mcp/servers", json={"servers": {"evil": {"command": command, "args": args}}})
+    assert r.status_code == 400, r.text
+
+
+def test_mcp_ordinary_servers_not_blocked_by_the_guard():
+    from hermes_cli.web_route_guard import mcp_command_error
+    assert mcp_command_error("npx", ["-y", "@modelcontextprotocol/server-filesystem", "."]) is None
+    assert mcp_command_error("uvx", ["mcp-server-git"]) is None
+    assert mcp_command_error("python", ["-m", "my_server"]) is None
+    assert mcp_command_error("python", ["server.py"]) is None
+    assert mcp_command_error(None, None) is None
