@@ -0,0 +1,149 @@
+"""Route guard for the Webapp's direct file, Git and MCP routes (Odysseus reviewed patch).
+
+The agent's file tools consult ``agent.file_safety`` (protected Hermes state, credentials, ``HERMES_WRITE_SAFE_ROOT``). The Webapp's direct REST routes
+(``/api/fs/write-text``, ``/api/files/*``, ``/api/git/*``, ``/api/mcp/*``) did not, so anything holding the Webapp credential could write or delete outside the
+safe root, replace plugin or config files, read the Webapp's own credential and register an arbitrary command as an MCP server. These helpers apply the SAME
+verdicts to those routes. They add no approval prompt: a REST call cannot tell a human click from a script, so this is a policy boundary, not a consent step.
+
+Not a sandbox: it does not stop a process that can already run commands as this user. Raise the cost of the web/token vector and keep parity with the agent guard.
+"""
+import json
+import os
+import re
+from pathlib import Path
+from typing import Optional
+
+from fastapi import HTTPException
+
+from agent import file_safety
+
+# Hermes-home entries that hold code or security settings which run or govern the next start. The agent guard leaves some of them editable on purpose (a user may
+# ask the agent to edit config.yaml); the direct routes are not a conversation, so they stay closed.
+_CONTROL_NAMES = ("plugins", "hooks", "desktop-plugins", "config.yaml", "cron")
+
+_SHELLS = frozenset({
+    "cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe", "bash", "bash.exe", "sh", "sh.exe", "zsh", "fish", "wscript", "wscript.exe",
+    "cscript", "cscript.exe", "mshta", "mshta.exe", "rundll32", "rundll32.exe", "regsvr32", "regsvr32.exe", "wsl", "wsl.exe", "msiexec", "msiexec.exe",
+    "certutil", "certutil.exe", "bitsadmin", "bitsadmin.exe",
+})
+_INTERPRETERS = frozenset({
+    "python", "python3", "python.exe", "pythonw.exe", "py", "py.exe", "node", "node.exe", "deno", "bun", "perl", "ruby", "php", "lua", "java", "java.exe",
+})
+_INLINE_FLAGS = frozenset({"-c", "-e", "-m=", "--eval", "-p", "--print", "-r", "-command", "-encodedcommand", "-enc", "-ec", "/c", "/k", "-exec", "--exec", "-x"})
+
+
+def _bases():
+    try:
+        return [Path(os.path.realpath(str(base))) for base in file_safety._hermes_dirs()]
+    except Exception:
+        home = os.environ.get("HERMES_HOME")
+        return [Path(os.path.realpath(home))] if home else []
+
+
+def _protected_roots():
+    roots = []
+    for base in _bases():
+        roots.extend(base / name for name in _CONTROL_NAMES + file_safety._HERMES_PROTECTED_SUBPATHS)
+    return roots
+
+
+def _user_blocked_roots():
+    """Folders the user listed as off limits in ``<home>/vault/webui-trusted-workspaces.json`` (``blocked``). Unreadable list -> None (caller fails closed)."""
+    roots = []
+    for base in _bases():
+        listing = base / "vault" / "webui-trusted-workspaces.json"
+        if not listing.is_file():
+            continue
+        try:
+            entries = json.loads(listing.read_text(encoding="utf-8")).get("blocked") or []
+            roots.extend(Path(os.path.realpath(str(entry["path"]))) for entry in entries if isinstance(entry, dict) and entry.get("path"))
+        except (OSError, ValueError, AttributeError, TypeError):
+            return None
+    return roots
+
+
+def _user_blocked(path: Path, *, contents: bool = False) -> Optional[bool]:
+    roots = _user_blocked_roots()
+    if roots is None:
+        return None
+    return any(_under(path, root) or (contents and _under(root, path)) for root in roots)
+
+
+def _under(path: Path, root: Path) -> bool:
+    try:
+        path.relative_to(root)
+        return True
+    except ValueError:
+        return False
+
+
+def write_error(path, verb: str = "Write", *, contents: bool = False) -> Optional[str]:
+    """The reason a write/delete/create at ``path`` must be refused, or None. ``contents=True`` (delete, move): also refuse a path that CONTAINS protected state."""
+    text = str(path)
+    error = file_safety.get_write_denied_error(text, verb=verb, entry=True)
+    if error:
+        return error
+    try:
+        resolved = Path(os.path.realpath(os.path.expanduser(text)))
+    except (OSError, ValueError):
+        return f"{verb} denied: '{text}' could not be resolved."
+    for root in _protected_roots():
+        if _under(resolved, root) or (contents and _under(root, resolved)):
+            return f"{verb} denied: '{text}' is Hermes code, configuration or credential state."
+    blocked = _user_blocked(resolved, contents=contents)
+    if blocked is None:
+        return f"{verb} denied: the list of blocked folders could not be read."
+    if blocked:
+        return f"{verb} denied: '{text}' is in a folder you marked as blocked."
+    return None
+
+
+def read_error(path) -> Optional[str]:
+    error = file_safety.get_read_block_error(str(path))
+    if error:
+        return error
+    try:
+        resolved = Path(os.path.realpath(os.path.expanduser(str(path))))
+    except (OSError, ValueError):
+        return "Read denied: the path could not be resolved."
+    blocked = _user_blocked(resolved)
+    if blocked is None or blocked:
+        return "Read denied: this folder is blocked."
+    return None
+
+
+def check_write(path, verb: str = "Write", *, contents: bool = False) -> None:
+    error = write_error(path, verb, contents=contents)
+    if error:
+        raise HTTPException(status_code=403, detail=error)
+
+
+def read_blocked(path) -> bool:
+    try:
+        return read_error(path) is not None
+    except Exception:
+        return True      # cannot decide -> blocked
+
+
+def check_repo(path) -> None:
+    """A mutating Git operation runs inside ``path``: it must be a place the agent guard would let a write land."""
+    error = write_error(path, "Git change")
+    if error:
+        raise HTTPException(status_code=403, detail=error.replace("Git change denied:", "Git changes are not allowed here:", 1))
+
+
+def mcp_command_error(command, args=None) -> Optional[str]:
+    """Why a stdio MCP server command is refused, or None. A shell, a script host, or an interpreter given inline code is arbitrary execution with no review."""
+    if not command:
+        return None
+    name = Path(str(command).strip().strip('"')).name.lower()
+    if name in _SHELLS:
+        return f"MCP command '{name}' is a shell or script host; install the server's own executable instead."
+    if name in _INTERPRETERS:
+        for arg in args or ():
+            lowered = str(arg).strip().lower()
+            if lowered in _INLINE_FLAGS or re.match(r"^-[a-z]*[ce]$", lowered):
+                return f"MCP command '{name} {arg}' runs inline code; point it at a script or module instead."
+    if re.search(r"[;&|`]|\$\(", str(command)):
+        return "MCP command contains shell operators."
+    return None
