diff --git a/tests/test_trusted_workspaces_prompts.py b/tests/test_trusted_workspaces_prompts.py
new file mode 100644
index 000000000..9d764e7c5
--- /dev/null
+++ b/tests/test_trusted_workspaces_prompts.py
@@ -0,0 +1,430 @@
+"""Inline approval prompts for Trusted Workspaces.
+
+A file tool refused for an unapproved folder waits for the human, then proceeds or is refused with the
+human's reason. These tests drive the real module with a stand-in for the Agent's write guard that emits
+the same refusal text, plus one test against the Agent's real ``tools.file_operations`` when importable.
+"""
+import os
+import shutil
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from api import trusted_workspaces as tw  # noqa: E402
+
+
+def fake_agent_guard(path, *, verb='Write', entry=False):
+    """Same contract and refusal text as agent.file_safety.get_write_denied_error for the safe-root case."""
+    roots = [r for r in os.environ.get(tw.ENV, '').split(os.pathsep) if r]
+    if 'credential' in str(path):                      # the real guard classifies credentials BEFORE the safe-root rule
+        return f"{verb} denied: '{path}' is a protected system/credential file."
+    if roots and not any(tw._is_under(path, r) for r in roots):
+        return f"{verb} denied: '{path}' is outside HERMES_WRITE_SAFE_ROOT ({os.pathsep.join(roots)}). Unset the variable."
+    return None
+
+
+def answer_when_asked(decision, results, **kwargs):
+    """Play the human: wait for a prompt to appear, answer it."""
+    def run():
+        for _ in range(100):
+            waiting = tw.pending(watch=True)
+            if waiting:
+                try:
+                    results.append(tw.decide(waiting[0]['id'], decision, **kwargs))
+                except Exception as exc:       # noqa: BLE001 - recorded for the assertion
+                    results.append(exc)
+                return
+            time.sleep(0.05)
+        results.append(None)
+    thread = threading.Thread(target=run, daemon=True)
+    thread.start()
+    return thread
+
+
+class PromptTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix='tw-test-')).resolve()
+        self.base = self.tmp / 'base'
+        self.work = self.tmp / 'work'
+        for d in (self.base, self.work / 'repo' / 'src', self.work / 'repo' / 'docs', self.work / 'plain'):
+            d.mkdir(parents=True)
+        (self.work / 'repo' / '.git').mkdir()
+        self.saved_env = os.environ.get(tw.ENV)
+        os.environ[tw.ENV] = str(self.base)
+        self.saved = (tw._hermes_home, tw.install_hook, tw.REQUEST_TTL, tw.REFUSAL_MEMORY, tw.MAX_PENDING)
+        tw._hermes_home = lambda: self.tmp / '_hermes_home'
+        tw.install_hook = lambda: False
+        self.session = 'chat-A'
+        self.real_current_session = tw._current_session
+        tw._current_session = lambda: self.session
+        tw._RECENT.clear()
+        tw._LAST_POLL = 0.0
+        self.assertTrue(tw.init())
+        self.guard = tw._guard(fake_agent_guard)
+
+    def tearDown(self):
+        tw._hermes_home, tw.install_hook, tw.REQUEST_TTL, tw.REFUSAL_MEMORY, tw.MAX_PENDING = self.saved
+        tw._current_session = self.real_current_session
+        tw._SESSION_GRANTS.clear()
+        tw._REQUESTS.clear()
+        tw._REFUSED.clear()
+        if self.saved_env is None:
+            os.environ.pop(tw.ENV, None)
+        else:
+            os.environ[tw.ENV] = self.saved_env
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def target(self, *parts):
+        return str(self.work.joinpath(*parts))
+
+    # -- the prompt itself ---------------------------------------------------------------------
+    def test_allow_once_lets_the_blocked_write_continue(self):
+        results = []
+        human = answer_when_asked('once', results)
+        verdict = self.guard(self.target('plain', 'a.txt'))
+        human.join(2)
+        self.assertIsNone(verdict, 'the write must proceed after approval')
+        self.assertEqual(results[0]['result'], 'once')
+        self.assertIsNone(self.guard(self.target('plain', 'b.txt')), 'no second prompt for the same folder')
+        self.assertIn(str(self.work / 'plain'), os.environ[tw.ENV])
+
+    def test_always_allow_is_saved_for_the_next_start(self):
+        results = []
+        human = answer_when_asked('always', results)
+        self.assertIsNone(self.guard(self.target('plain', 'a.txt')))
+        human.join(2)
+        self.assertEqual([e['path'] for e in tw._read_state()['always']], [str(self.work / 'plain')])
+        tw.init()                                   # simulated restart
+        self.assertIsNone(self.guard(self.target('plain', 'c.txt')))
+
+    def test_repository_scope_approves_the_whole_repo(self):
+        results = []
+        human = answer_when_asked('always', results, scope='repo')
+        self.assertIsNone(self.guard(self.target('repo', 'src', 'main.rs')))
+        human.join(2)
+        self.assertEqual(results[0]['path'], str(self.work / 'repo'))
+        self.assertIsNone(self.guard(self.target('repo', 'docs', 'readme.md')), 'sibling folder is covered')
+
+    def test_prompt_offers_the_repo_root_only_inside_a_repo(self):
+        seen = []
+
+        def look():
+            for _ in range(100):
+                waiting = tw.pending(watch=True)
+                if waiting:
+                    seen.append(waiting[0])
+                    tw.decide(waiting[0]['id'], 'deny')
+                    return
+                time.sleep(0.05)
+
+        for target in (self.target('repo', 'src', 'main.rs'), self.target('plain', 'a.txt')):
+            thread = threading.Thread(target=look, daemon=True)
+            thread.start()
+            self.guard(target)
+            thread.join(2)
+        self.assertEqual(seen[0]['repo'], str(self.work / 'repo'))
+        self.assertEqual(seen[0]['folder'], str(self.work / 'repo' / 'src'))
+        self.assertIsNone(seen[1]['repo'])
+
+    def test_deny_gives_the_agent_the_reason_and_stops_reprompting(self):
+        results = []
+        human = answer_when_asked('deny', results, note='that is my tax folder')
+        message = self.guard(self.target('plain', 'a.txt'))
+        human.join(2)
+        self.assertIn('declined', message)
+        self.assertIn('that is my tax folder', message)
+        started = time.monotonic()
+        again = self.guard(self.target('plain', 'b.txt'))
+        self.assertLess(time.monotonic() - started, 0.5, 'a repeat after Deny must not wait or prompt')
+        self.assertIn('already declined', again)
+        self.assertEqual(tw.pending(), [])
+
+    def test_never_allow_blocks_and_beats_an_approved_parent(self):
+        os.environ[tw.ENV] = os.pathsep.join([str(self.base), str(self.work)])
+        tw.init()
+        guard = tw._guard(fake_agent_guard)
+        self.assertIsNone(guard(self.target('plain', 'ok.txt')))
+        tw.block(self.target('plain'))
+        self.assertIn('never-allow', guard(self.target('plain', 'ok.txt')))
+        self.assertIsNone(guard(self.target('repo', 'src', 'ok.txt')), 'other folders stay allowed')
+        tw.unblock(self.target('plain'))
+        self.assertIsNone(guard(self.target('plain', 'ok.txt')))
+
+    def test_never_from_the_prompt_blocks_the_folder(self):
+        results = []
+        human = answer_when_asked('never', results)
+        message = self.guard(self.target('plain', 'a.txt'))
+        human.join(2)
+        self.assertIn('declined', message)
+        self.assertEqual(tw.status()['blocked'], [str(self.work / 'plain')])
+        with self.assertRaises(tw.WorkspaceError):
+            tw.approve(self.target('plain'), 'always')
+
+    # -- failing closed ------------------------------------------------------------------------
+    def test_no_browser_attending_fails_closed_at_once(self):
+        started = time.monotonic()
+        message = self.guard(self.target('plain', 'a.txt'))
+        self.assertLess(time.monotonic() - started, 0.5)
+        self.assertIn('no Hermes browser tab', message)
+        self.assertEqual(tw.pending(watch=False), [])
+
+    def test_unanswered_prompt_expires_and_refuses(self):
+        tw.REQUEST_TTL = 1
+        tw.pending(watch=True)
+        started = time.monotonic()
+        message = self.guard(self.target('plain', 'a.txt'))
+        self.assertLess(time.monotonic() - started, 4)
+        self.assertIn('none arrived', message)
+        self.assertEqual(tw.pending(watch=False), [])
+        self.assertNotIn(str(self.work / 'plain'), os.environ[tw.ENV])
+
+    def test_folders_that_can_never_be_approved_are_not_offered(self):
+        tw.pending(watch=True)
+        message = self.guard(str(Path.home() / 'notes.txt'))
+        self.assertIn('cannot be approved', message)
+        self.assertEqual(tw.pending(watch=False), [])
+
+    def test_credential_denials_are_never_promptable(self):
+        tw.pending(watch=True)
+        message = self.guard(str(self.base / 'credential-file'))
+        self.assertIn('protected system/credential file', message)
+        self.assertEqual(tw.pending(watch=False), [])
+
+    def test_concurrent_requests_for_one_folder_share_one_prompt(self):
+        tw.pending(watch=True)
+        outcomes = []
+        workers = [threading.Thread(target=lambda n=n: outcomes.append(self.guard(self.target('plain', f'{n}.txt')))) for n in range(3)]
+        for w in workers:
+            w.start()
+        time.sleep(0.4)
+        waiting = tw.pending(watch=True)
+        self.assertEqual(len(waiting), 1)
+        tw.decide(waiting[0]['id'], 'once')
+        for w in workers:
+            w.join(3)
+        self.assertEqual(outcomes, [None, None, None])
+
+    def test_prompt_flood_is_capped(self):
+        tw.MAX_PENDING = 2
+        tw.pending(watch=True)
+        workers = [threading.Thread(target=lambda n=n: self.guard(self.target('plain', f'{n}', 'x.txt')), daemon=True) for n in range(2)]
+        for n in range(2):
+            (self.work / 'plain' / str(n)).mkdir(exist_ok=True)
+        for w in workers:
+            w.start()
+        time.sleep(0.4)
+        (self.work / 'plain' / 'third').mkdir()
+        message = self.guard(self.target('plain', 'third', 'x.txt'))
+        self.assertIn('too many approvals', message)
+        for item in tw.pending(watch=True):
+            tw.decide(item['id'], 'deny')
+
+    def test_one_answer_settles_other_waiting_requests_it_covers(self):
+        tw.pending(watch=True)
+        outcomes = []
+        for sub in ('src', 'docs'):
+            threading.Thread(target=lambda s=sub: outcomes.append(self.guard(self.target('repo', s, 'f.txt'))), daemon=True).start()
+        time.sleep(0.5)
+        waiting = tw.pending(watch=True)
+        self.assertEqual(len(waiting), 2)
+        tw.decide(waiting[0]['id'], 'once', scope='repo')
+        time.sleep(1.0)
+        self.assertEqual(outcomes, [None, None], 'the repo approval releases both')
+
+    # -- answering is validated ----------------------------------------------------------------
+    def test_decide_rejects_bad_input_and_stale_ids(self):
+        with self.assertRaises(tw.WorkspaceError):
+            tw.decide('nope', 'once')
+        with self.assertRaises(tw.WorkspaceError):
+            tw.decide('nope', 'maybe')
+
+    def test_note_is_cleaned_and_bounded(self):
+        results = []
+        human = answer_when_asked('deny', results, note='line1\nline2\x00' + 'x' * 1000)
+        message = self.guard(self.target('plain', 'a.txt'))
+        human.join(2)
+        self.assertNotIn('\n', message)
+        self.assertLess(len(message), 700)
+
+    def test_state_file_keeps_blocked_entries_across_approvals(self):
