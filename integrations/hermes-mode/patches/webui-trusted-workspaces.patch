index 000000000..eabc74fd8
--- /dev/null
+++ b/api/windows_console.py
@@ -0,0 +1,64 @@
+"""Stop console child processes of the windowless WebUI from opening Windows Terminal windows.
+
+The WebUI normally runs as ``pythonw.exe`` (no console). A console program it starts without
+``CREATE_NO_WINDOW`` (the Claude provider's ``claude.exe``, ``taskkill``, ``reg``, MCP launchers, ...)
+gets a brand-new console, and with Windows Terminal as the default terminal each one opens a window.
+
+This adds ``CREATE_NO_WINDOW`` to ``subprocess.Popen`` calls in a console-less Windows process, and
+only when the caller did not choose its own console behaviour. It never removes a window the caller
+asked for, never touches a process that has a console, and is inert off Windows. Set
+``HERMES_WEBUI_SHOW_CONSOLES=1`` to turn it off.
+"""
+import os
+import subprocess
+import sys
+
+CREATE_NEW_CONSOLE = 0x00000010
+DETACHED_PROCESS = 0x00000008
+CREATE_NO_WINDOW = 0x08000000
+_CALLER_CHOSE = CREATE_NEW_CONSOLE | DETACHED_PROCESS | CREATE_NO_WINDOW
+_CREATIONFLAGS_POSITION = 13        # Popen(args, bufsize, executable, stdin, stdout, stderr, preexec_fn,
+                                    #       close_fds, shell, cwd, env, universal_newlines, startupinfo, creationflags)
+
+
+def _has_console():
+    try:
+        import ctypes
+        return bool(ctypes.windll.kernel32.GetConsoleWindow())
+    except Exception:
+        return True                 # unknown: do not change behaviour
+
+
+def active():
+    return bool(getattr(subprocess.Popen, '_hermes_no_console', False))
+
+
+def install(force=False):
+    """Wrap ``subprocess.Popen.__init__`` once. Returns True when the wrapper is active."""
+    if active():
+        return True
+    if not force:
+        if os.name != 'nt' or os.environ.get('HERMES_WEBUI_SHOW_CONSOLES', '').strip() == '1' or _has_console():
+            return False
+    original = subprocess.Popen.__init__
+
+    def __init__(self, *args, **kwargs):
+        if len(args) <= _CREATIONFLAGS_POSITION:
+            flags = kwargs.get('creationflags', 0) or 0
+            if not flags & _CALLER_CHOSE:
+                kwargs['creationflags'] = flags | CREATE_NO_WINDOW
+        original(self, *args, **kwargs)
+
+    __init__._hermes_original = original
+    subprocess.Popen.__init__ = __init__
+    subprocess.Popen._hermes_no_console = True
+    return True
+
+
+def uninstall():
+    wrapper = subprocess.Popen.__init__
+    original = getattr(wrapper, '_hermes_original', None)
+    if original is not None:
+        subprocess.Popen.__init__ = original
+    if hasattr(subprocess.Popen, '_hermes_no_console'):
+        del subprocess.Popen._hermes_no_console
