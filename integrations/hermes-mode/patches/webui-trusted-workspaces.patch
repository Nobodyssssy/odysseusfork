+"""Failed-load recovery and local diagnostics (static/diagnostics.js) wiring and behavior."""
+import json
+import pathlib
+import shutil
+import subprocess
+
+import pytest
+
+STATIC = pathlib.Path(__file__).resolve().parent.parent / "static"
+DIAG = STATIC / "diagnostics.js"
+NODE = shutil.which("node")
+
+HARNESS = r"""
+const fs = require('fs');
+const store = {};
+global.localStorage = {getItem: k => (k in store ? store[k] : null), setItem: (k, v) => { store[k] = String(v); }, removeItem: k => { delete store[k]; }};
+global.navigator = {userAgent: 'test'};
+global.location = {pathname: '/'};
+const listeners = {};
+global.window = global;
+global.addEventListener = (n, f) => { listeners[n] = f; };
+global.crypto = require('crypto').webcrypto;
+eval(fs.readFileSync(process.argv[2], 'utf8'));
+const D = window.HermesDiag;
+const out = {};
+out.redacted = D.redact('Authorization: Bearer abcdefghijklmnop and sk-abcdefghijklmnopqrstuv ?token=hunter22hunter');
+for (let i = 0; i < 200; i++) D.record('server_error', 'x'.repeat(2000) + i);
+out.count = D.events().length;
+out.bytes = store['hermes-webui-diag-v1'].length;
+out.fieldLen = D.events()[0].detail.length;
+out.id = /^E-[0-9a-f]{8}$/.test(D.events()[0].id);
+out.cls = [D.classify({status: 500}).category, D.classify({status: 404}).category, D.classify(new Error('Failed to fetch')).category, D.classify({message: 'request timed out'}).category, D.classify({status: 429}).category];
+listeners.error({message: 'boom token=abcdefabcdef', filename: 'http://h/static/ui.js', lineno: 9});
+out.lastCat = D.events().slice(-1)[0].category;
+out.lastDetail = D.events().slice(-1)[0].detail;
+console.log(JSON.stringify(out));
+"""
+
+
+@pytest.mark.skipif(NODE is None, reason="node not installed")
+def test_diagnostics_redact_bound_classify_and_record_global_errors(tmp_path):
+    harness = tmp_path / "h.cjs"
+    harness.write_text(HARNESS, encoding="utf-8")
+    result = subprocess.run([NODE, str(harness), str(DIAG)], capture_output=True, text=True, timeout=60)
+    assert result.returncode == 0, result.stderr
+    out = json.loads(result.stdout.strip().splitlines()[-1])
+    assert "abcdefghijklmnop" not in out["redacted"] and "hunter22hunter" not in out["redacted"]
+    assert "sk-abcdefghijklmnopqrstuv" not in out["redacted"]
+    assert out["count"] <= 40 and out["bytes"] <= 24000
+    assert out["fieldLen"] <= 401
+    assert out["id"] is True
+    assert out["cls"] == ["server_error", "not_found", "connection", "timeout", "rate_limited"]
+    assert out["lastCat"] == "js_error" and "abcdefabcdef" not in out["lastDetail"]
+
+
+def test_diagnostics_is_loaded_precached_and_used_by_failed_loads():
+    index = (STATIC / "index.html").read_text(encoding="utf-8")
+    sw = (STATIC / "sw.js").read_text(encoding="utf-8")
+    sessions = (STATIC / "sessions.js").read_text(encoding="utf-8")
+    assert index.index('static/diagnostics.js?v=__WEBUI_VERSION__') < index.index('static/sessions.js?v=__WEBUI_VERSION__')
+    assert "'./static/diagnostics.js' + VQ" in sw
+    assert sessions.count("HermesDiag.renderFailure(") == 2          # metadata load and message load both get Retry
+    assert "Couldn't load earlier messages" in sessions               # scroll-back failure is no longer silent
+    src = DIAG.read_text(encoding="utf-8")
+    assert "fetch(" not in src and "setInterval" not in src           # local only, no background work
