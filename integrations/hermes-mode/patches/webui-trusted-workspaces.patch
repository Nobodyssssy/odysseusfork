diff --git a/api/trusted_workspaces.py b/api/trusted_workspaces.py
new file mode 100644
index 000000000..41c99ed8a
--- /dev/null
+++ b/api/trusted_workspaces.py
@@ -0,0 +1,553 @@
+"""Trusted Workspaces: folders the user has approved for the Agent's file tools.
+
+How it works
+------------
+The Agent's file tools already refuse writes outside ``HERMES_WRITE_SAFE_ROOT`` and re-read that
+variable on every operation. Agent runs execute inside this process, so this module keeps the
+variable equal to *the roots configured at launch* plus *the folders the user approved*. An approval or
+revocation therefore takes effect on the next file operation, including in a run that is already active.
+No restart and no change to the Agent are needed.
+
+What it is not
+--------------
+This is a permission for Hermes's *file tools*. It is NOT an operating-system sandbox: the terminal tool,
+other programs and anything else running as your Windows account are unaffected. A model with a shell can
+still reach any file you can. Approvals are made by the browser dialog (a same-origin request carrying
+browser provenance headers); the Agent has no tool that approves a folder. A process running as you that
+forges those headers can still approve; defending against that needs a separate Windows account, which this
+feature deliberately does not install.
+
+Rules
+-----
+* Launch-time roots are preserved and cannot be revoked here.
+* An empty list is never "unrestricted": with nothing approved the variable points at an empty private directory.
+* The feature is inactive (nothing changes) unless ``HERMES_WRITE_SAFE_ROOT`` is already set or
+  ``HERMES_WEBUI_TRUSTED_WORKSPACES=1``.
+* Approvals bind the folder's identity (volume + file id). A folder replaced by a junction or another
+  directory is dropped from the effective roots until it is approved again.
+* Drive roots, the home folder, Hermes's own home (and anything containing it), system folders, UNC and
+  NT-namespace paths are refused.
+"""
+import collections
+import json
+import logging
+import os
+from pathlib import Path
+import re
+import threading
+import time
+import uuid
+
+logger = logging.getLogger(__name__)
+
+REQUEST_TTL = 120          # seconds a blocked write waits for the human before it is refused
+ATTENDED_WINDOW = 15       # a browser must have polled within this many seconds, else nobody can answer
+MAX_PENDING = 4            # cap on simultaneous prompts (a runaway loop cannot flood the page)
+REFUSAL_MEMORY = 300       # after "Deny", the same folder is refused without re-prompting for this long
+MAX_NOTE = 300
+
+ENV = 'HERMES_WRITE_SAFE_ROOT'
+ENABLE_ENV = 'HERMES_WEBUI_TRUSTED_WORKSPACES'
+_LOCK = threading.RLock()
+_BASE = None            # launch-time roots, captured once and never fed back
+_ENABLED = False
+_ONCE = {}              # canonical path -> identity; lives for this process only
+_STATE_FILE = None
+_EMPTY_DIR = None
+_REQUESTS = {}          # id -> pending access request (a blocked write waiting for the human)
+_REFUSED = {}           # canonical folder -> (until, note) after the user said no
+_RECENT = collections.deque(maxlen=50)   # audit trail of decisions, newest last
+_LAST_POLL = 0.0        # monotonic time a browser last asked for pending requests
+_HOOKED = False
+
+
+class WorkspaceError(ValueError):
+    pass
+
+
+def _norm(path):
+    return os.path.normcase(os.path.realpath(path))
+
+
+def _is_under(path, root):
+    path, root = _norm(path), _norm(root)
+    return path == root or path.startswith(root.rstrip('\\/') + os.sep)
+
+
+def _identity(path):
+    info = os.stat(path)
+    return [int(info.st_dev), int(info.st_ino)]
+
+
+def _hermes_home():
+    try:
+        from api.profiles import get_active_hermes_home
+        return Path(get_active_hermes_home())
+    except Exception:
+        return Path(os.environ.get('HERMES_HOME') or Path.home() / '.hermes')
+
+
+def _forbidden_ancestors():
+    """A folder equal to or containing any of these may not be approved."""
+    home = Path.home()
+    items = [_hermes_home(), home]
+    for name in ('SystemRoot', 'windir', 'ProgramFiles', 'ProgramFiles(x86)', 'ProgramData'):
+        if os.environ.get(name):
+            items.append(Path(os.environ[name]))
+    return items
+
+
+def canonicalize(path):
+    """Return the canonical real directory for ``path`` or raise WorkspaceError with a user-facing reason."""
+    if not isinstance(path, str) or not path.strip() or '\x00' in path or len(path) > 1024:
+        raise WorkspaceError('Choose a folder.')
+    raw = path.strip().strip('"').strip("'")
+    if raw.startswith(('\\\\?\\', '\\\\.\\', '//?/', '//./')) or raw.startswith(('\\\\', '//')):
+        raise WorkspaceError('Network and device paths cannot be approved.')
+    if not os.path.isabs(raw):
+        raise WorkspaceError('Use a full folder path, for example F:\\Project.')
+    try:
+        real = os.path.realpath(raw)
+    except (OSError, ValueError) as exc:
+        raise WorkspaceError('That folder could not be resolved.') from exc
+    if not os.path.isdir(real):
+        raise WorkspaceError('That folder does not exist.')
+    if os.path.dirname(real.rstrip('\\/')) == real.rstrip('\\/') or os.path.splitdrive(real)[1] in ('', '\\', '/'):
+        raise WorkspaceError('A whole drive cannot be approved. Choose a project folder.')
+    try:
+        if _is_under(real, _hermes_home()):
+            raise WorkspaceError('Hermes\'s own data folder cannot be approved.')
+    except OSError:
+        pass
+    for protected in _forbidden_ancestors():
+        try:
+            if _is_under(protected, real):
+                raise WorkspaceError('That folder contains system, account or Hermes data and cannot be approved.')
+        except OSError:
+            continue
+    try:
+        from api.workspace import _is_blocked_system_path
+        if _is_blocked_system_path(Path(real)):
+            raise WorkspaceError('That is a system folder and cannot be approved.')
+    except ImportError:
+        pass
+    return real
+
+
+def _read_state():
+    try:
+        data = json.loads(_STATE_FILE.read_text(encoding='utf-8')) if _STATE_FILE and _STATE_FILE.exists() else {}
+    except (OSError, ValueError):
+        if _STATE_FILE and _STATE_FILE.exists():
+            try:
+                _STATE_FILE.replace(_STATE_FILE.with_suffix('.corrupt'))   # keep what could not be read
+            except OSError:
+                pass
+        return {'version': 1, 'always': [], 'blocked': []}
+    valid = isinstance(data, dict) and data.get('version') == 1
+    items = data.get('always') if valid else []
+    clean = [i for i in (items or []) if isinstance(i, dict) and isinstance(i.get('path'), str) and isinstance(i.get('id'), list)]
+    blocked = [i for i in ((data.get('blocked') if valid else []) or []) if isinstance(i, dict) and isinstance(i.get('path'), str)]
+    return {'version': 1, 'always': clean, 'blocked': blocked}
+
+
+def _write_state(state):
+    _STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
+    temporary = _STATE_FILE.with_name(_STATE_FILE.name + '.tmp')
+    temporary.write_text(json.dumps(state, indent=2), encoding='utf-8')
+    os.replace(temporary, _STATE_FILE)
+
+
+def _live_roots():
+    """(roots that currently count, stale entries) from always + once, verifying identity."""
+    roots, stale = [], []
+    for entry in _read_state()['always']:
+        try:
+            ok = os.path.isdir(entry['path']) and _identity(entry['path']) == entry['id']
+        except OSError:
+            ok = False
+        (roots if ok else stale).append(entry['path'])
+    for path, ident in list(_ONCE.items()):
+        try:
+            if os.path.isdir(path) and _identity(path) == ident:
+                roots.append(path)
+                continue
+        except OSError:
+            pass
+        _ONCE.pop(path, None)
+    return roots, stale
+
+
+def _apply():
+    """Make the live variable equal base + approvals. Never writes an empty value."""
+    roots, _ = _live_roots()
+    effective = list(dict.fromkeys([*(_BASE or ()), *roots]))
+    if not effective:
+        _EMPTY_DIR.mkdir(parents=True, exist_ok=True)
+        effective = [str(_EMPTY_DIR)]
+    os.environ[ENV] = os.pathsep.join(effective)
+
+
+def init(state_dir=None):
+    """Capture launch-time roots and apply saved approvals. Call once at WebUI startup."""
+    global _BASE, _ENABLED, _STATE_FILE, _EMPTY_DIR
+    with _LOCK:
+        launch = [p for p in os.environ.get(ENV, '').split(os.pathsep) if p.strip()]
+        _ENABLED = bool(launch) or os.environ.get(ENABLE_ENV, '').strip().lower() in ('1', 'true', 'yes', 'on')
+        home = _hermes_home()
+        # `vault` is a protected sub-path for the Agent's file tools, so the approvals list is not writable by them.
+        _STATE_FILE = home / 'vault' / 'webui-trusted-workspaces.json'
+        _EMPTY_DIR = home / 'vault' / 'webui-trusted-workspaces-empty'
+        _BASE = tuple(launch)
+        _ONCE.clear()
+        _REQUESTS.clear()
+        _REFUSED.clear()
+        if _ENABLED:
+            _apply()
+            install_hook()
+            logger.info('Trusted Workspaces active: %d launch root(s), %d saved approval(s)', len(_BASE), len(_read_state()['always']))
+        return _ENABLED
+
+
+def enabled():
+    return _ENABLED
+
+
+def is_trusted(path):
+    """True when writes to ``path`` are currently allowed (always true while the feature is inactive)."""
+    with _LOCK:
+        if not _ENABLED:
+            return True
+        try:
+            if _blocked_match(path):
+                return False
+            roots, _ = _live_roots()
+            return any(_is_under(path, r) for r in [*(_BASE or ()), *roots])
+        except OSError:
+            return False
+
+
+def check(path):
+    try:
+        canonical = canonicalize(path)
+    except WorkspaceError as exc:
+        return {'enabled': _ENABLED, 'trusted': False, 'canonical': None, 'error': str(exc)}
+    return {'enabled': _ENABLED, 'trusted': is_trusted(canonical), 'canonical': canonical, 'error': None}
+
+
+def status():
+    with _LOCK:
+        roots, stale = _live_roots() if _ENABLED else ([], [])
+        saved = {os.path.normcase(e['path']): e for e in _read_state()['always']} if _ENABLED else {}
+        return {
+            'enabled': _ENABLED,
+            'configured': list(_BASE or ()),
+            'always': [{'path': e['path'], 'added': e.get('added'), 'active': e['path'] in roots} for e in saved.values()],
+            'once': sorted(_ONCE),
+            'stale': stale,
+            'blocked': [e['path'] for e in _read_state()['blocked']] if _ENABLED else [],
+            'recent': list(_RECENT),
+            'prompts_active': _HOOKED,
+            'note': 'Controls Hermes file tools only. It is not an operating-system sandbox.',
+        }
+
+
+def approve(path, mode):
+    if mode not in ('once', 'always'):
+        raise WorkspaceError('Choose Allow once or Always allow.')
+    with _LOCK:
+        if not _ENABLED:
+            raise WorkspaceError('Trusted Workspaces is not active for this Hermes.')
+        canonical = canonicalize(path)
+        if _blocked_match(canonical):
+            raise WorkspaceError('That folder is on the "never allow" list. Remove it from there first.')
+        if any(_is_under(canonical, r) for r in (_BASE or ())):
+            return {'result': 'already_configured', 'path': canonical}
+        ident = _identity(canonical)
+        if mode == 'once':
+            _ONCE[canonical] = ident
+        else:
+            state = _read_state()
+            state['always'] = [e for e in state['always'] if _norm(e['path']) != _norm(canonical)]
+            state['always'].append({'path': canonical, 'id': ident, 'added': time.strftime('%Y-%m-%dT%H:%M:%S')})
+            _write_state(state)
+        _apply()
+        return {'result': mode, 'path': canonical}
+
+
+def revoke(path):
+    with _LOCK:
+        if not _ENABLED:
+            raise WorkspaceError('Trusted Workspaces is not active for this Hermes.')
+        target = os.path.normcase(os.path.realpath(path)) if isinstance(path, str) else ''
+        if any(os.path.normcase(os.path.realpath(r)) == target for r in (_BASE or ())):
+            raise WorkspaceError('This folder is configured when Hermes starts (HERMES_WRITE_SAFE_ROOT) and cannot be revoked here.')
+        removed = False
+        state = _read_state()
+        kept = [e for e in state['always'] if os.path.normcase(os.path.realpath(e['path'])) != target]
+        if len(kept) != len(state['always']):
+            removed = True
+            state['always'] = kept
+            _write_state(state)
+        for key in [k for k in _ONCE if os.path.normcase(os.path.realpath(k)) == target]:
+            _ONCE.pop(key)
+            removed = True
+        _apply()
+        return {'result': 'revoked' if removed else 'not_found', 'path': path}
+
+
+# --------------------------------------------------------------------------------------------------
+# "Never allow" list: deny always beats allow, whatever approved folder the path sits in.
+# --------------------------------------------------------------------------------------------------
+
+def _timestamp():
+    return time.strftime('%Y-%m-%dT%H:%M:%S')
+
+
+def _log(event, folder, verb, note=''):
+    _RECENT.append({'time': _timestamp(), 'event': event, 'folder': folder, 'verb': verb, 'note': note})
+
+
+def _blocked_match(path):
+    """The never-allow entry covering ``path``, or None."""
+    try:
+        for entry in _read_state()['blocked']:
+            if _is_under(path, entry['path']):
+                return entry['path']
+    except OSError:
+        return None
+    return None
+
+
+def block(path):
+    with _LOCK:
+        if not _ENABLED:
+            raise WorkspaceError('Trusted Workspaces is not active for this Hermes.')
+        raw = path.strip().strip('"') if isinstance(path, str) else ''
+        if not raw or '\x00' in raw or not os.path.isabs(raw) or raw.startswith(('\\\\', '//')):
+            raise WorkspaceError('Use a full local path, for example F:\\Project\\.env')
+        real = os.path.realpath(raw)
+        state = _read_state()
+        if not any(_norm(e['path']) == _norm(real) for e in state['blocked']):
+            state['blocked'].append({'path': real, 'added': _timestamp()})
+            _write_state(state)
+        _log('never-allow', real, '')
+        return {'result': 'blocked', 'path': real}
+
+
+def unblock(path):
+    with _LOCK:
+        if not _ENABLED:
+            raise WorkspaceError('Trusted Workspaces is not active for this Hermes.')
+        target = _norm(path) if isinstance(path, str) and path.strip() else ''
+        state = _read_state()
+        kept = [e for e in state['blocked'] if _norm(e['path']) != target]
+        removed = len(kept) != len(state['blocked'])
+        if removed:
+            state['blocked'] = kept
+            _write_state(state)
+            _log('unblocked', path, '')
+        return {'result': 'unblocked' if removed else 'not_found', 'path': path}
+
+
+# --------------------------------------------------------------------------------------------------
+# Inline access requests (the Claude Code / Codex style prompt).
+#
+# When a file tool is refused because its folder is not approved, the tool call does not simply fail:
+# it waits (up to REQUEST_TTL seconds) for the human to answer in the browser, then carries on, or is
+# refused with the human's reason. Only a click in the Hermes page can answer; the Agent has no tool
+# for it. With no browser attending, or when the Stop button is pressed, the request fails closed.
+# --------------------------------------------------------------------------------------------------
+
+def _existing_dir(path):
+    candidate = os.path.realpath(path)
+    if not os.path.isdir(candidate):
+        candidate = os.path.dirname(candidate)
+    while candidate and not os.path.isdir(candidate):
+        parent = os.path.dirname(candidate)
+        if parent == candidate:
+            return None
+        candidate = parent
+    return candidate or None
+
+
+def _repo_root(folder):
+    current = folder
+    while True:
+        if os.path.exists(os.path.join(current, '.git')):
+            return current
+        parent = os.path.dirname(current)
+        if parent == current:
+            return None
+        current = parent
+
+
+def _clean_note(note):
+    text = re.sub(r'[\x00-\x1f\x7f]+', ' ', note) if isinstance(note, str) else ''
+    return text.strip()[:MAX_NOTE]
+
+
+def _denied(verb, path, why):
+    return {'granted': False, 'message': f"{verb} denied: '{path}' {why}"}
+
+
+def _interrupted():
+    try:
+        from tools.interrupt import is_interrupted
+        return bool(is_interrupted())
+    except Exception:
+        return False
+
+
+def request_access(path, verb='Write'):
+    """Block the calling tool until the human answers.
+
+    Returns None when this feature has nothing to say, else {'granted': bool, 'message': str}.
+    """
+    if not _ENABLED:
+        return None
+    try:
+        located = _existing_dir(path)
+        if not located:
+            return _denied(verb, path, 'is in a location that does not exist.')
+        folder = canonicalize(located)
+    except WorkspaceError as exc:
+        _log('cannot-approve', str(path), verb, str(exc))
+        return _denied(verb, path, f'cannot be approved ({exc}). Tell the user; do not retry.')
+    except OSError:
+        return _denied(verb, path, 'could not be resolved.')
+    if _blocked_match(folder):
+        return _denied(verb, path, 'is on the user\'s never-allow list. Do not retry; ask the user.')
+
+    with _LOCK:
+        now = time.monotonic()
+        refused = _REFUSED.get(_norm(folder))
+        if refused and refused[0] > now:
+            reason = f' Reason from the user: "{refused[1]}".' if refused[1] else ''
+            return _denied(verb, path, f'the user already declined access to this folder.{reason} Do not ask again unless the user asks you to.')
+        request = next((r for r in _REQUESTS.values() if _norm(r['folder']) == _norm(folder) and r.get('decision') is None), None)
+        if request is None:
+            if now - _LAST_POLL > ATTENDED_WINDOW:
+                _log('unattended', folder, verb)
+                return _denied(verb, path, 'is outside the approved folders and no Hermes browser tab is open to approve it. Ask the user to approve the folder in Settings > Trusted folders.')
+            if len(_REQUESTS) >= MAX_PENDING:
+                return _denied(verb, path, 'needs approval but too many approvals are already waiting. Ask the user to answer them first.')
+            repo = _repo_root(folder)
+            try:
+                repo = canonicalize(repo) if repo and _norm(repo) != _norm(folder) else None
+            except WorkspaceError:
+                repo = None
+            request = {'id': uuid.uuid4().hex, 'folder': folder, 'repo': repo, 'file': str(path), 'verb': verb,
+                       'created': _timestamp(), 'deadline': now + REQUEST_TTL, 'event': threading.Event(), 'decision': None, 'note': ''}
+            _REQUESTS[request['id']] = request
+            _log('asked', folder, verb)
+
+    deadline = request['deadline']
+    while not request['event'].wait(0.5):
+        if time.monotonic() >= deadline or _interrupted():
+            break
+    with _LOCK:
+        _REQUESTS.pop(request['id'], None)
+        decision = request.get('decision')
+        if decision is None:
+            request['decision'] = 'expired'
+            _log('expired', folder, verb)
+    if decision == 'granted' and is_trusted(path):
+        return {'granted': True, 'message': ''}
+    if decision == 'denied':
+        reason = f' Reason from the user: "{request["note"]}".' if request.get('note') else ''
+        return _denied(verb, path, f'the user declined access to this folder.{reason} Do not retry; continue without it or ask the user.')
+    if decision is None:
+        return _denied(verb, path, f'needs the user\'s approval and none arrived within {REQUEST_TTL} seconds (or the run was stopped).')
+    return _denied(verb, path, 'is still outside the approved folders.')
+
+
+def pending(watch=True):
+    """Waiting requests, for the browser to show. ``watch`` records that a human is attending."""
+    global _LAST_POLL
+    with _LOCK:
+        now = time.monotonic()
+        if watch:
+            _LAST_POLL = now
+        return [{'id': r['id'], 'file': r['file'], 'verb': r['verb'], 'folder': r['folder'], 'repo': r['repo'],
+                 'created': r['created'], 'expires_in': max(0, int(r['deadline'] - now))}
+                for r in _REQUESTS.values() if r.get('decision') is None]
+
+
+def decide(request_id, decision, scope='folder', note=''):
+    """Answer a waiting request: once | always | deny | never. ``scope`` is 'folder' or 'repo'."""
+    if decision not in ('once', 'always', 'deny', 'never'):
+        raise WorkspaceError('Choose Allow once, Always allow, Deny or Never allow.')
+    with _LOCK:
+        request = _REQUESTS.get(request_id) if isinstance(request_id, str) else None
+        if request is None or request.get('decision') is not None:
+            raise WorkspaceError('That request is no longer waiting.')
+        target = request['repo'] if scope == 'repo' and request.get('repo') else request['folder']
+        text = _clean_note(note)
+        if decision in ('once', 'always'):
+            approve(target, decision)      # refuses blocked/forbidden folders; the request stays waiting on error
+            request['decision'] = 'granted'
+        else:
+            if decision == 'never':
+                block(target)
+            _REFUSED[_norm(request['folder'])] = (time.monotonic() + REFUSAL_MEMORY, text)
+            request['decision'] = 'denied'
+            request['note'] = text
+        _log(decision, target, request['verb'], text)
+        request['event'].set()
+        for other in _REQUESTS.values():      # one answer can settle other waiting requests it now covers
+            if other is request or other.get('decision') is not None:
+                continue
+            if _blocked_match(other['folder']):
+                other['decision'] = 'denied'
+            elif is_trusted(other['folder']):
+                other['decision'] = 'granted'
+            else:
+                continue
+            other['event'].set()
+        return {'result': decision, 'path': target}
+
+
+def _guard(original):
+    """Wrap the file tools' write guard so a refusal for an unapproved folder becomes a prompt."""
+    def guarded(path, *args, **kwargs):
+        message = original(path, *args, **kwargs)
+        verb = kwargs.get('verb', 'Write')
+        if message is None:
+            if _ENABLED and _blocked_match(path):
+                return f"{verb} denied: '{path}' is on the user's never-allow list. Do not retry; ask the user."
+            return None
+        if 'outside HERMES_WRITE_SAFE_ROOT' not in message:
+            return message                    # credential/protected-file denials are never promptable
+        try:
+            verdict = request_access(path, verb)
+        except Exception:
+            logger.exception('Trusted Workspaces: access request failed; keeping the original refusal')
+            return message
+        if verdict is None:
+            return message
+        if verdict['granted']:
+            return original(path, *args, **kwargs)
+        return verdict['message']
+    guarded._tw_guard = True
+    return guarded
+
+
+def install_hook():
+    """Wrap the write guard used by the file tools in this process. Fails soft: if the Agent's module
+    layout is not as expected nothing prompts and the plain refusal remains."""
+    global _HOOKED
+    try:
+        from tools import file_operations
+    except Exception as exc:
+        logger.warning('Trusted Workspaces: inline prompts unavailable (%s)', exc)
+        _HOOKED = False
+        return False
+    current = getattr(file_operations, 'get_write_denied_error', None)
+    if current is None:
+        _HOOKED = False
+        return False
+    if not getattr(current, '_tw_guard', False):
+        file_operations.get_write_denied_error = _guard(current)
+    _HOOKED = True
+    return True
