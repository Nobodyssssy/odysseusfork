diff --git a/static/diagnostics.js b/static/diagnostics.js
new file mode 100644
index 000000000..282851772
--- /dev/null
+++ b/static/diagnostics.js
@@ -0,0 +1,138 @@
+/* Lightweight local diagnostics and load-failure recovery.
+ *
+ * No network, no background timers. A small ring buffer of redacted client errors lives in
+ * localStorage so a crash that reloads the page can still be explained afterwards.
+ * Each failure gets a short event id the user can quote; "Copy diagnostics" copies the buffer.
+ */
+(function(){
+  'use strict';
+  var KEY='hermes-webui-diag-v1';
+  var MAX_EVENTS=40;          // oldest dropped first
+  var MAX_FIELD=400;          // characters kept per text field
+  var MAX_BYTES=24000;        // hard cap on the stored buffer
+
+  var SECRET_PATTERNS=[
+    [/(authorization|cookie|set-cookie)\s*[:=]\s*[^\r\n,;]+/ig,'$1=[redacted]'],
+    [/\bBearer\s+[A-Za-z0-9._~+\/=-]{8,}/g,'Bearer [redacted]'],
+    [/\b(sk|pk|rk|ghp|gho|xox[abps])[-_][A-Za-z0-9_-]{12,}/g,'[redacted-key]'],
+    [/([?&](?:token|key|api_key|apikey|access_token|password|csrf)=)[^&\s]+/ig,'$1[redacted]'],
+    [/\b(api[_-]?key|token|secret|password)["']?\s*[:=]\s*["']?[^\s"',}]{6,}/ig,'$1=[redacted]']
+  ];
+
+  function redact(text){
+    var s=String(text==null?'':text);
+    for(var i=0;i<SECRET_PATTERNS.length;i++) s=s.replace(SECRET_PATTERNS[i][0],SECRET_PATTERNS[i][1]);
+    return s.length>MAX_FIELD?s.slice(0,MAX_FIELD)+'…':s;
+  }
+
+  function eventId(){
+    var a='';
+    try{
+      var b=new Uint8Array(4); crypto.getRandomValues(b);
+      for(var i=0;i<b.length;i++) a+=('0'+b[i].toString(16)).slice(-2);
+    }catch(_){ a=Math.random().toString(16).slice(2,10); }
+    return 'E-'+a;
+  }
+
+  function read(){
+    try{ var v=JSON.parse(localStorage.getItem(KEY)||'[]'); return Array.isArray(v)?v:[]; }catch(_){ return []; }
+  }
+
+  function write(events){
+    while(events.length>MAX_EVENTS) events.shift();
+    var text=JSON.stringify(events);
+    while(text.length>MAX_BYTES && events.length>1){ events.shift(); text=JSON.stringify(events); }
+    try{ localStorage.setItem(KEY,text); }catch(_){ /* storage full or blocked: diagnostics stay best-effort */ }
+  }
+
+  function record(category,detail,extra){
+    var id=eventId();
+    var entry={id:id,t:new Date().toISOString(),category:String(category||'unknown'),detail:redact(detail)};
+    if(extra&&typeof extra==='object'){
+      var keep={};
+      Object.keys(extra).slice(0,8).forEach(function(k){
+        var v=extra[k];
+        keep[k]=(typeof v==='number'||typeof v==='boolean')?v:redact(v);
+      });
+      entry.extra=keep;
+    }
+    var events=read(); events.push(entry); write(events);
+    return id;
+  }
+
+  /* Maps a failed request to a short category plus what the user can do. Never retries anything itself. */
+  function classify(err){
+    var status=err&&typeof err.status==='number'?err.status:0;
+    var text=String((err&&err.message)||err||'');
+    if(status===401) return {category:'auth',message:'Your sign-in expired',action:'Sign in again, then retry.'};
+    if(status===403) return {category:'forbidden',message:'This session is not available to the current profile',action:'Switch profile or choose another session.'};
+    if(status===404) return {category:'not_found',message:'This session no longer exists',action:'Choose another session.'};
+    if(status===413||/payload too large/i.test(text)) return {category:'too_large',message:'This conversation is too large to load in one piece',action:'Retry; if it keeps failing, start a continuation.'};
+    if(status===429) return {category:'rate_limited',message:'The server is busy',action:'Wait a moment, then retry.'};
+    if(status>=500) return {category:'server_error',message:'The server failed while loading this session',action:'Retry. Nothing was lost; the session is stored on disk.'};
+    if(/abort|timeout|timed out/i.test(text)) return {category:'timeout',message:'Loading took too long',action:'Retry. Long sessions can take a few seconds.'};
+    return {category:'connection',message:'Connection to the server was lost',action:'Check that the server is running, then retry.'};
+  }
+
+  function copyText(text){
+    try{
+      if(navigator.clipboard&&navigator.clipboard.writeText) return navigator.clipboard.writeText(text);
+    }catch(_){ }
+    return Promise.reject(new Error('clipboard unavailable'));
+  }
+
+  function snapshot(){
+    var nav=(typeof navigator!=='undefined')?navigator:{};
+    return JSON.stringify({
+      version:window.__HERMES_WEBUI_BUNDLE_VERSION__||'',
+      userAgent:redact(nav.userAgent||''),
+      page:redact(location.pathname),
+      events:read()
+    },null,2);
+  }
+
+  /* Replaces `container` content with a recovery card. All text is set with textContent (no HTML from errors). */
+  function renderFailure(container,opts){
+    if(!container) return null;
+    opts=opts||{};
+    var info=classify(opts.error);
+    var id=record(info.category,(opts.error&&opts.error.message)||String(opts.error||''),{
+      what:opts.what||'load',session:opts.sessionId?String(opts.sessionId).slice(0,12):'',status:(opts.error&&opts.error.status)||0});
+
+    var wrap=document.createElement('div');
+    wrap.className='load-failure-card';
+    wrap.setAttribute('role','alert');
+    wrap.style.cssText='display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;height:100%;color:var(--text-muted);font-size:14px;padding:40px;text-align:center;';
+
+    function line(text,style){ var d=document.createElement('div'); d.textContent=text; if(style) d.style.cssText=style; wrap.appendChild(d); return d; }
+    line((opts.title||'Could not load this conversation')+' — '+info.message,'font-weight:600;color:var(--text);');
+    line(info.action);
+    line('Your messages are stored on disk and were not changed. Reference '+id,'font-size:12px;opacity:.8;');
+
+    var row=document.createElement('div'); row.style.cssText='display:flex;gap:8px;';
+    function button(label,handler){
+      var b=document.createElement('button'); b.type='button'; b.textContent=label; b.className='btn';
+      b.style.cssText='padding:6px 14px;cursor:pointer;';
+      b.addEventListener('click',handler); row.appendChild(b); return b;
+    }
+    if(typeof opts.retry==='function'){
+      var retry=button('Retry',function(){ retry.disabled=true; retry.textContent='Retrying…'; try{ opts.retry(); }catch(_){ retry.disabled=false; retry.textContent='Retry'; } });
+    }
+    var copy=button('Copy diagnostics',function(){
+      copyText(snapshot()).then(function(){ copy.textContent='Copied'; },function(){ copy.textContent='Copy failed'; });
+    });
+    wrap.appendChild(row);
+    container.replaceChildren(wrap);
+    return id;
+  }
+
+  /* Global handlers record, never swallow: the browser still reports the error in its console. */
+  window.addEventListener('error',function(ev){
+    record('js_error',(ev&&ev.message)||'error',{source:ev&&ev.filename?String(ev.filename).split('/').pop():'',line:(ev&&ev.lineno)||0});
+  });
+  window.addEventListener('unhandledrejection',function(ev){
+    var r=ev&&ev.reason; record('unhandled_rejection',(r&&r.message)||String(r||''));
+  });
+
+  window.HermesDiag={record:record,classify:classify,renderFailure:renderFailure,events:read,snapshot:snapshot,redact:redact,clear:function(){ try{ localStorage.removeItem(KEY); }catch(_){ } }};
+})();
