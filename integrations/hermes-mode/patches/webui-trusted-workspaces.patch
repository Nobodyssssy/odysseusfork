diff --git a/static/trusted-workspaces.js b/static/trusted-workspaces.js
new file mode 100644
index 000000000..13e29b215
--- /dev/null
+++ b/static/trusted-workspaces.js
@@ -0,0 +1,167 @@
+/* Trusted Workspaces: asks before Hermes's file tools may write in a newly chosen folder.
+ * A permission for Hermes's file tools only; it is not an operating-system sandbox.
+ * Approvals are made only from a click in this dialog. */
+(function () {
+  'use strict';
+  const nativeFetch = window.fetch.bind(window);
+  const GATED = /\/api\/(session\/new|session\/update|workspaces\/add)$/;
+  const api = path => new URL(path, document.baseURI).href;
+  let enabled = null;
+  const pending = new Map();
+  let queue = Promise.resolve();
+
+  async function json(path, init) {
+    const response = await nativeFetch(api(path), { credentials: 'include', headers: { 'Content-Type': 'application/json' }, ...init });
+    let data = {};
+    try { data = await response.json(); } catch (_) { /* non-JSON */ }
+    return { ok: response.ok, status: response.status, data };
+  }
+
+  const ready = json('api/trusted-workspaces').then(r => { enabled = r.ok && r.data.enabled === true; }).catch(() => { enabled = false; });
+
+  function el(tag, props, ...children) {
+    const node = Object.assign(document.createElement(tag), props || {});
+    node.append(...children);
+    return node;
+  }
+
+  function askUser(canonical) {
+    return new Promise(resolve => {
+      const previous = document.activeElement;
+      const overlay = el('div', { id: 'trusted-workspaces-overlay' });
+      overlay.style.cssText = 'position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;font:14px system-ui,sans-serif';
+      const box = el('div', { role: 'alertdialog' });
+      box.setAttribute('aria-modal', 'true');
+      box.setAttribute('aria-labelledby', 'tw-title');
+      box.setAttribute('aria-describedby', 'tw-body');
+      box.style.cssText = 'max-width:560px;width:calc(100% - 32px);background:var(--bg,#1f2124);color:var(--text,#e8e4db);border:1px solid var(--border,#484848);border-radius:10px;padding:20px;box-shadow:0 10px 40px rgba(0,0,0,.5)';
+      const path = el('code', { textContent: canonical });
+      path.style.cssText = 'display:block;margin:10px 0;padding:8px 10px;border-radius:6px;background:rgba(127,127,127,.18);word-break:break-all;user-select:all';
+      const status = el('div', { id: 'tw-status', role: 'status' });
+      const button = (label, mode, primary) => {
+        const b = el('button', { type: 'button', textContent: label });
+        b.style.cssText = 'padding:8px 14px;border-radius:7px;border:1px solid var(--border,#484848);background:' + (primary ? '#2d6a4f' : 'transparent') + ';color:inherit;cursor:pointer;font:inherit';
+        b.dataset.mode = mode;
+        return b;
+      };
+      const deny = button('Deny', 'deny');
+      const once = button('Allow once', 'once');
+      const always = button('Always allow', 'always', true);
+      const buttons = el('div', {}, deny, once, always);
+      buttons.style.cssText = 'display:flex;gap:8px;justify-content:flex-end;margin-top:14px';
+      box.append(
+        el('h2', { id: 'tw-title', textContent: 'Allow Hermes to write in this folder?' }),
+        el('div', { id: 'tw-body', textContent: 'Hermes\'s file tools will be able to create and change files in this folder and everything inside it:' }),
+        path,
+        el('div', { textContent: 'This controls Hermes\'s file tools only. It is not an operating-system sandbox. Allow once lasts until Hermes restarts; Always allow is remembered and can be revoked from "Trusted folders".' }),
+        status, buttons);
+      box.querySelector('#tw-title').style.cssText = 'margin:0 0 8px;font-size:17px';
+      overlay.append(box);
+      document.body.append(overlay);
+      deny.focus();
+
+      const close = result => { overlay.remove(); document.removeEventListener('keydown', onKey, true); if (previous && previous.focus) previous.focus(); resolve(result); };
+      const onKey = event => {
+        if (event.key === 'Escape') { event.preventDefault(); close({ ok: false, message: 'Folder not allowed.' }); }
+        if (event.key === 'Tab') {
+          const items = [deny, once, always];
+          const index = items.indexOf(document.activeElement);
+          event.preventDefault();
+          items[(index + (event.shiftKey ? items.length - 1 : 1)) % items.length].focus();
+        }
+      };
+      document.addEventListener('keydown', onKey, true);
+      deny.addEventListener('click', () => close({ ok: false, message: 'Folder not allowed.' }));
+      for (const choice of [once, always]) {
+        choice.addEventListener('click', async event => {
+          if (!event.isTrusted) return;      // only a real click can approve
+          for (const b of [deny, once, always]) b.disabled = true;
+          const r = await json('api/trusted-workspaces/approve', { method: 'POST', body: JSON.stringify({ path: canonical, mode: choice.dataset.mode }) });
+          if (r.ok) return close({ ok: true });
+          status.textContent = r.data.error || 'The folder could not be approved.';
+          for (const b of [deny, once, always]) b.disabled = false;
+          deny.focus();
+        });
+      }
+    });
+  }
+
+  function ensureTrusted(path) {
+    return ready.then(async () => {
+      if (!enabled) return { ok: true };
+      const check = await json('api/trusted-workspaces/check?path=' + encodeURIComponent(path));
+      if (!check.ok || check.data.error || check.data.trusted) return { ok: true };   // invalid paths are reported by the normal route
+      const key = check.data.canonical;
+      if (!pending.has(key)) {
+        const run = queue.then(() => askUser(key)).finally(() => pending.delete(key));
+        queue = run.catch(() => {});
+        pending.set(key, run);
+      }
+      return pending.get(key);
+    }).catch(() => ({ ok: true }));
+  }
+
+  window.fetch = async function (input, init) {
+    try {
+      const url = typeof input === 'string' ? input : (input && input.url) || '';
+      const method = String((init && init.method) || (input && input.method) || 'GET').toUpperCase();
+      if (method === 'POST' && init && typeof init.body === 'string' && GATED.test(new URL(url, document.baseURI).pathname)) {
+        const body = JSON.parse(init.body);
+        const target = typeof body.workspace === 'string' && body.workspace ? body.workspace : (typeof body.path === 'string' ? body.path : '');
+        if (target && /^[A-Za-z]:[\\/]/.test(target)) {
+          const verdict = await ensureTrusted(target);
+          if (!verdict.ok) return new Response(JSON.stringify({ error: verdict.message }), { status: 403, headers: { 'Content-Type': 'application/json' } });
+        }
+      }
+    } catch (_) { /* never block the page on a parsing problem */ }
+    return nativeFetch(input, init);
+  };
+
+  /* Settings > Preferences > "Trusted folders": list and revoke, inline. */
+  const SECTION_ID = 'trusted-folders-section';
+
+  async function renderSettings() {
+    const pane = document.getElementById('settingsPanePreferences');
+    if (!pane || !enabled) return;
+    let section = document.getElementById(SECTION_ID);
+    if (!section) {
+      section = el('div', { id: SECTION_ID, className: 'settings-field' });
+      const save = pane.querySelector('button[onclick*="saveSettings"]');
+      pane.insertBefore(section, save || null);
+    }
+    const r = await json('api/trusted-workspaces');
+    const rows = [];
+    const row = (path, kind, removable) => {
+      const line = el('div', {}, el('code', { textContent: path }), el('span', { textContent: ' ' + kind }));
+      line.style.cssText = 'display:flex;align-items:center;gap:8px;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(127,127,127,.25);word-break:break-all;font-size:12px';
+      if (removable) {
+        const b = el('button', { type: 'button', textContent: 'Revoke', className: 'sm-btn' });
+        b.addEventListener('click', async event => {
+          if (!event.isTrusted) return;
+          b.disabled = true;
+          const res = await json('api/trusted-workspaces/revoke', { method: 'POST', body: JSON.stringify({ path }) });
+          if (res.ok) renderSettings(); else { b.disabled = false; b.textContent = res.data.error || 'Failed'; }
+        });
+        line.append(b);
+      }
+      rows.push(line);
+    };
+    if (r.ok && r.data.enabled) {
+      for (const path of r.data.configured) row(path, '(set when Hermes starts; cannot be revoked here)', false);
+      for (const item of r.data.always) row(item.path, item.active ? '(always)' : '(always; folder changed, needs re-approval)', true);
+      for (const path of r.data.once) row(path, '(until Hermes restarts)', true);
+      if (!rows.length) rows.push(el('div', { textContent: 'No folders are trusted. Hermes cannot write anywhere until you approve one.' }));
+    }
+    const hint = el('div', { textContent: "Folders Hermes's file tools may write in. This is a permission for those tools only, not an operating-system sandbox." });
+    hint.style.cssText = 'font-size:11px;color:var(--muted);margin-bottom:6px';
+    section.replaceChildren(el('label', { textContent: 'Trusted folders' }), hint, ...rows);
+  }
+
