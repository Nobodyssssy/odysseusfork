diff --git a/tests/tools/test_mcp_sdk_recovery.py b/tests/tools/test_mcp_sdk_recovery.py
new file mode 100644
index 0000000000..4fec91ca3d
--- /dev/null
+++ b/tests/tools/test_mcp_sdk_recovery.py
@@ -0,0 +1,155 @@
+"""A gateway whose import-time probe found no ``mcp`` SDK must say so, and recover once the SDK is importable.
+
+Live incident: the managed gateway's dependency environment had no ``mcp`` package, so ``_MCP_AVAILABLE`` was
+False for the whole process; every discovery pass (startup and the per-minute reconcile) returned at DEBUG level
+and the configured servers silently never connected.
+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def sdk_missing(monkeypatch):
+    """The state of a process that started without the SDK on its path."""
+    from tools import mcp_tool, mcp_tool_discovery as disc
+
+    monkeypatch.setattr(mcp_tool, "_MCP_AVAILABLE", False)
+    monkeypatch.setattr(mcp_tool, "_MCP_SPEC_MISSING_AT_IMPORT", True)
+    monkeypatch.setattr(mcp_tool, "_mcp_sdk_last_probe", 0.0)
+    monkeypatch.setattr(disc, "_blocker_announced", set())
+    monkeypatch.setattr(disc, "_stalled_announced", frozenset())
+    return mcp_tool, disc
+
+
+def _spec_probe(monkeypatch, mcp_tool, found: list):
+    calls: list = []
+
+    def find_spec(name):
+        calls.append(name)
+        return object() if found[0] else None
+
+    monkeypatch.setattr(mcp_tool.importlib.util, "find_spec", find_spec)
+    return calls
+
+
+def test_reprobe_enables_sdk_once_importable_and_is_rate_limited(monkeypatch, sdk_missing):
+    mcp_tool, _ = sdk_missing
+    found = [False]
+    calls = _spec_probe(monkeypatch, mcp_tool, found)
+
+    assert mcp_tool._reprobe_mcp_sdk() is False
+    found[0] = True  # the environment is repaired, but the probe is inside its interval
+    assert mcp_tool._reprobe_mcp_sdk() is False
+    assert len(calls) == 1
+
+    monkeypatch.setattr(mcp_tool, "_mcp_sdk_last_probe", mcp_tool.time.monotonic() - 31)
+    assert mcp_tool._reprobe_mcp_sdk() is True
+    assert mcp_tool._MCP_AVAILABLE is True
+
+
+def test_sdk_on_path_but_unimportable_is_unavailable_and_names_the_error_once(monkeypatch, caplog):
+    """A found-but-broken SDK (missing transitive dependency) used to read as available with its names unbound,
+    so every connect failed with an unrelated AttributeError."""
+    from tools import mcp_tool
+
+    monkeypatch.setattr(mcp_tool, "_MCP_AVAILABLE", True)
+    monkeypatch.setattr(mcp_tool, "_MCP_SPEC_MISSING_AT_IMPORT", False)
+    monkeypatch.setattr(mcp_tool, "_MCP_SDK_IMPORT_ATTEMPTED", False)
+    monkeypatch.setattr(mcp_tool, "ClientSession", None)
+    monkeypatch.setattr(mcp_tool, "_mcp_sdk_warned_error", "")
+    monkeypatch.setattr(mcp_tool, "_mcp_sdk_last_probe", mcp_tool.time.monotonic())
+
+    def broken(module, names, missing_msg=None):
+        mcp_tool._MCP_SDK_IMPORT_ERROR = "ModuleNotFoundError: No module named 'pywintypes'"
+        return False
+
+    monkeypatch.setattr(mcp_tool, "_import_sdk_names", broken)
+    caplog.set_level(logging.WARNING, logger="tools.mcp_tool")
+
+    assert mcp_tool._ensure_mcp_sdk() is False
+    assert mcp_tool._MCP_AVAILABLE is False and mcp_tool._MCP_SDK_IMPORT_ATTEMPTED is False
+    assert mcp_tool._MCP_SPEC_MISSING_AT_IMPORT is True, "eligible for the periodic re-probe"
+    monkeypatch.setattr(mcp_tool, "_MCP_AVAILABLE", True)  # the re-probe finds it again; same error
+    assert mcp_tool._ensure_mcp_sdk() is False
+    warned = [r for r in caplog.records if "cannot be imported" in r.getMessage()]
+    assert len(warned) == 1 and "pywintypes" in warned[0].getMessage()
+
+
+def test_patched_unavailable_sdk_is_never_reprobed(monkeypatch):
+    from tools import mcp_tool
+
+    monkeypatch.setattr(mcp_tool, "_MCP_AVAILABLE", False)
+    monkeypatch.setattr(mcp_tool, "_MCP_SPEC_MISSING_AT_IMPORT", False)
+    _spec_probe(monkeypatch, mcp_tool, [True])
+    assert mcp_tool._ensure_mcp_sdk() is False
+
+
+def test_blocked_discovery_warns_once_names_servers_and_rearms(monkeypatch, caplog, sdk_missing):
+    mcp_tool, disc = sdk_missing
+    found = [False]
+    _spec_probe(monkeypatch, mcp_tool, found)
+    monkeypatch.setattr(mcp_tool, "_mcp_sdk_last_probe", mcp_tool.time.monotonic())  # no probe inside the test
+    caplog.set_level(logging.DEBUG, logger="tools.mcp_tool")
+
+    servers = {"wiki": {"command": "python"}, "rea": {"command": "npx"}}
+    assert disc.register_mcp_servers(servers) == []
+    assert disc.register_mcp_servers(servers) == []
+    blocked = [r for r in caplog.records if r.levelno == logging.WARNING and "discovery blocked" in r.getMessage()]
+    assert len(blocked) == 1, "a blocker repeats every reconcile tick; it is announced once"
+    text = blocked[0].getMessage()
+    assert "rea, wiki" in text and "not importable" in text and "mcp' extra" in text
+    assert disc.not_connected_reason().startswith("the 'mcp' Python SDK is not importable")
+
+    monkeypatch.setattr(mcp_tool, "_ensure_mcp_sdk", lambda: True)  # repaired: the blocker clears and re-arms
+    assert disc._sdk_ready_or_announce(servers) is True
+    assert "sdk" not in disc._blocker_announced
+    assert disc.not_connected_reason() == "" or not mcp_tool._MCP_AVAILABLE
+
+
+def test_reconcile_names_servers_discovery_left_without_a_trace(monkeypatch, tmp_path: Path, caplog, sdk_missing):
+    mcp_tool, disc = sdk_missing
+    from tools import mcp_tool_config as _config
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(_config, "_load_mcp_config", lambda: {"wiki": {"command": "python"}})
+    monkeypatch.setattr(disc, "discover_mcp_tools", lambda *a, **k: [])  # returns, connects nothing, records nothing
+    caplog.set_level(logging.WARNING, logger="tools.mcp_tool")
+
+    first = disc.reconcile_mcp_servers_with_config()
+    second = disc.reconcile_mcp_servers_with_config()
+
+    assert first["added"] == second["added"] == ["wiki"]
+    assert disc.last_stalled() == ["wiki"]
+    stalled = [r for r in caplog.records if "no connection and no recorded failure" in r.getMessage()]
+    assert len(stalled) == 1, "an unchanged stall is not re-announced every tick"
+    assert "not importable" in stalled[0].getMessage()
+
+
+def test_reconcile_chore_logs_a_repeated_attempt_once(monkeypatch, tmp_path: Path, caplog):
+    from gateway.run_profile_reconcile import _mcp_config_reconciler
+    from tools import mcp_tool_discovery as disc
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("mcp_servers:\n  wiki:\n    command: python\n")
+    result = {"removed": [], "added": ["wiki"], "pending": []}
+    monkeypatch.setattr(disc, "reconcile_mcp_servers_with_config", lambda: dict(result))
+    monkeypatch.setattr(disc, "_stalled_announced", frozenset())
+    caplog.set_level(logging.INFO, logger="gateway.run_profile_reconcile")
+    tick = _mcp_config_reconciler(runner=None)
+
+    for _ in range(4):  # baseline, then three identical attempts
+        tick()
+    lines = [r for r in caplog.records if "MCP servers reconciled with config" in r.getMessage()]
+    assert len(lines) == 1
+
+    result["added"] = []  # connected: a later regression is news again
+    tick()
+    result["added"] = ["wiki"]
+    tick()
+    lines = [r for r in caplog.records if "MCP servers reconciled with config" in r.getMessage()]
+    assert len(lines) == 2
diff --git a/tools/mcp_tool.py b/tools/mcp_tool.py
index 8992500c5e..642ff2a7b5 100644
--- a/tools/mcp_tool.py
+++ b/tools/mcp_tool.py
@@ -89,6 +89,15 @@ try:
     _MCP_AVAILABLE = importlib.util.find_spec("mcp") is not None
 except Exception:
     _MCP_AVAILABLE = False
