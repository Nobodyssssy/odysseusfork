     try:
         mod = importlib.import_module(module)
         values = {n: getattr(mod, n) for n in names}
-    except (ImportError, AttributeError):
+    except (ImportError, AttributeError) as exc:
+        _MCP_SDK_IMPORT_ERROR = f"{type(exc).__name__}: {exc}"
         if missing_msg:
