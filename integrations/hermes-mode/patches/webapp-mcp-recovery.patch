+import { ConfirmDialog } from '@/components/ui/confirm-dialog'
+import { useI18n } from '@/i18n'
+
+import type { McpServersController } from '../mcp/use-mcp-servers'
+
+export interface ReloadMcpConfirmProps {
+  controller: Pick<McpServersController, 'reloadServers'>
+  onClose: () => void
+  open: boolean
+}
+
+/** Consent gate for the manual reload: `reload.mcp` refreshes every chat of the profile and can refresh the
+ *  prompt cache, so it never fires from a bare click. */
+export function ReloadMcpConfirm({ controller, onClose, open }: ReloadMcpConfirmProps) {
+  const { t } = useI18n()
+  const copy = t.connectorsPage.add
+
+  return (
+    <ConfirmDialog
+      confirmLabel={copy.reloadAction}
+      description={copy.reloadBody}
+      doneLabel={copy.reloadDone}
+      onClose={onClose}
+      onConfirm={() => controller.reloadServers()}
+      open={open}
+      title={copy.reloadTitle}
+    />
+  )
+}
