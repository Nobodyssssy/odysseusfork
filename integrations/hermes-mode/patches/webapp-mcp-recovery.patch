@@ -0,0 +1,44 @@
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { ReloadMcpConfirm } from './reload-mcp-confirm'
+
+afterEach(cleanup)
+
+describe('Reload MCP servers consent', () => {
+  it('asks first and only reloads once confirmed', async () => {
+    const reloadServers = vi.fn(async () => undefined)
+    const onClose = vi.fn()
+
+    render(<ReloadMcpConfirm controller={{ reloadServers }} onClose={onClose} open />)
+
+    expect(screen.getByText('Reload MCP servers?')).toBeTruthy()
+    expect(reloadServers).not.toHaveBeenCalled()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Reload MCP servers' }))
+
+    await waitFor(() => expect(reloadServers).toHaveBeenCalledTimes(1))
+  })
+
+  it('does not reload when dismissed', () => {
+    const reloadServers = vi.fn(async () => undefined)
+    const onClose = vi.fn()
+
+    render(<ReloadMcpConfirm controller={{ reloadServers }} onClose={onClose} open />)
+    fireEvent.click(screen.getByRole('button', { name: 'Cancel' }))
+
+    expect(reloadServers).not.toHaveBeenCalled()
+    expect(onClose).toHaveBeenCalled()
+  })
+
+  it('keeps the dialog open and shows the failure when the gateway refuses', async () => {
+    const reloadServers = vi.fn(async () => {
+      throw new Error('did not connect: wiki')
+    })
+
+    render(<ReloadMcpConfirm controller={{ reloadServers }} onClose={vi.fn()} open />)
+    fireEvent.click(screen.getByRole('button', { name: 'Reload MCP servers' }))
+
+    expect(await screen.findByText(/did not connect: wiki/)).toBeTruthy()
+  })
+})
