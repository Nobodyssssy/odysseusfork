@@ -140,6 +151,40 @@ def _import_sdk_names(module: str, names: tuple, missing_msg: Optional[str] = No
     return True
 
 
+def mcp_sdk_unavailable_reason() -> str:
+    """Why this process cannot start MCP servers, for operator-facing diagnostics."""
+    import sys
+    return (f"the 'mcp' Python SDK is not importable by this process (interpreter {sys.executable}; "
+            f"first sys.path entries: {', '.join(sys.path[:4])}); install the Hermes 'mcp' extra into the "
+            f"environment this process actually loads. Discovery re-checks every "
+            f"{int(_MCP_SDK_REPROBE_INTERVAL_S)}s and connects the servers once the SDK is importable")
+
+
+def _reprobe_mcp_sdk() -> bool:
+    """Recover from an SDK that was absent at import: a process whose import-time probe found no ``mcp``
+    would otherwise skip MCP for its whole life, however the environment is repaired afterwards.
+    Rate-limited; only for the real import-time miss (see ``_MCP_SPEC_MISSING_AT_IMPORT``)."""
